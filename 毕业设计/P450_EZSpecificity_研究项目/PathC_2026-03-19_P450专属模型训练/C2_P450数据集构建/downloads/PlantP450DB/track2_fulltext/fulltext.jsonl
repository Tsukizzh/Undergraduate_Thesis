ssigning-authority=\"pmc\">10.1073/pnas.1423555112</pub-id><pub-id pub-id-type=\"pmcid\">PMC4371906</pub-id></mixed-citation></ref><ref id=\"R6\"><label>6.</label><mixed-citation publication-type=\"journal\"><name name-style=\"western\"><surname>Qu</surname><given-names>Y</given-names></name>\n<etal/>, <source>Proc. Natl. Acad. Sci. U.S.A</source>\n<volume>112</volume>, <fpage>6224</fpage>–<lpage>6229</lpage> (<year>2015</year>).<pub-id pub-id-type=\"pmid\">25918424</pub-id><pub-id pub-id-type=\"doi\" assigning-authority=\"pmc\">10.1073/pnas.1501821112</pub-id><pub-id pub-id-type=\"pmcid\">PMC4434687</pub-id></mixed-citation></ref><ref id=\"R7\"><label>7.</label><mixed-citation publication-type=\"journal\"><name name-style=\"western\"><surname>Cimermancic</surname><given-names>P</given-names></name>\n<etal/>, <source>Cell</source>\n<volume>158</volume>, <fpage>412</fpage>–<lpage>421</lpage> (<year>2014</year>).<pub-id pub-id-type=\"pmid\">25036635</pub-id><pub-id pub-id-type=\"doi\" assigning-authority=\"pmc\">10.1016/j.cell.2014.06.034</pub-id><pub-id pub-id-type=\"pmcid\">PMC4123684</pub-id></mixed-citation></ref><ref id=\"R8\"><label>8.</label><mixed-citation publication-type=\"journal\"><name name-style=\"western\"><surname>Stähelin</surname><given-names>HF</given-names></name>, <name name-style=\"western\"><surname>von Wartburg</surname><given-names>A</given-names></name>, <source>Cancer Res</source>\n<volume>51</volume>, <fpage>5</fpage>–<lpage>15</lpage> (<year>1991</year>).<pub-id pub-id-type=\"pmid\">1988106</pub-id></mixed-citation></ref><ref id=\"R9\"><label>9.</label><mixed-citation publication-type=\"journal\"><name name-style=\"western\"><surname>Canel</surname><given-names>C</given-names></name>, <name name-style=\"western\"><surname>Moraes</surname><given-names>RM</given-names></name>, <name name-style=\"western\"><surname>Dayan</surname><given-names>FE</given-names></name>, <name name-style=\"western\"><surname>Ferreira</surname><given-names>D</give