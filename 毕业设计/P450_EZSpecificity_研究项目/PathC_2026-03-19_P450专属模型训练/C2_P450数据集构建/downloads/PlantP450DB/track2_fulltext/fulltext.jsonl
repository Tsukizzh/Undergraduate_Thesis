eft\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">GGPPS:CPS:MiS:ATR1:</td><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">Miltiradiene</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">0.73±0.14</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">0.20±0.04</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">1</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">1.87</td></tr><tr><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">CYP76AH22:CYP76AK8</td><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">Ferruginol</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">0.39±0.09</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">0.11±0.03</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">0.53</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">1</td></tr><tr><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\"> </td><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">Carnosic acid</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">8.26±1.64</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">2.74±0.55</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">11.31</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">21.18</td></tr><tr><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">GGPPS:CPS:MiS:ATR1:</td><td align=\"left\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">Miltiradiene</td><td align=\"center\" valign=\"top\" charoff=\"50\" colspan=\"1\" rowspan=\"1\">2.41±0.25</td><td align=\"center\" valign=\"top\" charoff=\"50\" 